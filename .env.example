APP_NAME="Land Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=land_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ---- Outgoing mail (Gmail SMTP, use a Google "App Password", not the normal password)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=landoffice@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=landoffice@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Incoming mail (Gmail IMAP) - system reads director replies from this inbox
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=landoffice@gmail.com
IMAP_PASSWORD=
IMAP_DEFAULT_ACCOUNT=default
IMAP_PROTOCOL=imap

# ---- Approval settings (can also be changed from Settings page)
LANDMS_DIRECTOR_EMAIL=irfanbayg@gmail.com
LANDMS_APPROVAL_CC="RGOFFICER1@gmail.com,ibaigmuhamd@gmail.com"
LANDMS_SENDER_NAME="M Ilyas"
LANDMS_SENDER_DEPARTMENT="Accounts"
LANDMS_APPROVAL_LINK_DAYS=7
LANDMS_MARLA_SQFT=270
